GEMINI_API_KEY=<your-api-key>

# Upstash (or any Redis) connection string.
REDIS_URL=redis://default:<password>@<host>:<port>

# Per-browser and site-wide daily caps on Gemini usage.
DAILY_USER_CAP=3
GLOBAL_DAILY_CALL_CAP=300

MAX_TOPIC_CHARS=300

# Comma-separated list of exact origins allowed to call this API (scheme +
# host, no trailing slash) -- the hosted frontend(s) only.
# e.g. https://multi-persona-debate.vercel.app
CORS_ORIGINS=http://localhost:5500

# Cross-domain deployments (frontend and backend on different hosts) need
# SameSite=None + Secure for the rate-limit cookie to be sent at all; both
# require HTTPS, which Render/Vercel/Netlify provide automatically.
COOKIE_SAMESITE=none
COOKIE_SECURE=true

# Shared secret for GET /admin/stats
# `python3 -c "import secrets; print(secrets.token_urlsafe(32))"`.
ADMIN_TOKEN=
