GEMINI_API_KEY=<your-api-key>

# Upstash (or any Redis) connection string. Leave unset for local dev and the
# app falls back to an in-memory cache/counters -- fine for one process on
# your laptop, not for production (state resets on restart, isn't shared
# across instances).
REDIS_URL=redis://default:<password>@<host>:<port>

# Per-browser and site-wide daily caps on Gemini usage. A debate call is
# expensive relative to a single LLM call (2 rounds x 2-4 personas + 1
# optional moderator = 5-9 Gemini calls per request), so these default lower
# than a typical single-call app's caps.
DAILY_USER_CAP=3
GLOBAL_DAILY_CALL_CAP=300

MAX_TOPIC_CHARS=300

# Comma-separated list of exact origins allowed to call this API (scheme +
# host, no trailing slash) -- the hosted frontend(s) only.
# e.g. https://multi-persona-debate.vercel.app
CORS_ORIGINS=http://localhost:5500

# Cross-domain deployments (frontend and backend on different hosts) need
# SameSite=None + Secure for the rate-limit cookie to be sent at all; both
# require HTTPS, which Render/Vercel/Netlify provide automatically.
COOKIE_SAMESITE=none
COOKIE_SECURE=true

# Shared secret for GET /admin/stats (today's usage vs. the global cap).
# Leave unset to keep the endpoint disabled (404). Generate one with e.g.
# `python3 -c "import secrets; print(secrets.token_urlsafe(32))"`.
ADMIN_TOKEN=
